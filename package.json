{
  "name": "batchplane",
  "version": "0.0.0",
  "private": true,
  "description": "BatchPlane batch control and audit platform. Git-backed Lite first, scheduler adapters later.",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @batchplane/web dev",
    "build": "pnpm verify:action-artifacts && pnpm -r build",
    "build:actions": "pnpm --filter @batchplane/dispatcher-action build && pnpm --filter @batchplane/gate-action build && pnpm --filter @batchplane/schedule-request-action build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "bootstrap:actionlint": "go install github.com/rhysd/actionlint/cmd/actionlint@v1.7.12",
    "verify:action-artifacts": "node scripts/verify-action-artifacts.mjs",
    "verify:integrity": "pnpm verify:action-artifacts && node scripts/verify-workflows.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.0.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "yaml": "^2.8.1"
  }
}
